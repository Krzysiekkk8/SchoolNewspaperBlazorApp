@inherits LayoutComponentBase

<div class="animated-background">
    <div class="ambient-orb orb-one"></div>
    <div class="ambient-orb orb-two"></div>
    <div class="ambient-orb orb-three"></div>
    <div class="background-grid"></div>
</div>

<header class="site-header">
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand brand-logo" href="/">
                <span class="brand-symbol">G</span>
                <span>GAZETKA<span class="brand-dot">.</span></span>
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavigation"
                    aria-controls="mainNavigation"
                    aria-expanded="false"
                    aria-label="Otwórz menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavigation">
                <div class="navbar-nav mx-auto navigation-links">
                    <a class="nav-link" href="/">Główna</a>
                    <a class="nav-link" href="/aktualnosci">Aktualności</a>
                    <a class="nav-link" href="/wydarzenia">Wydarzenia</a>
                    <a class="nav-link" href="/adminPanel">Administracja</a>
                </div>

                <a href="/aktualnosci" class="header-cta">
                    Odkrywaj <span>↗</span>
                </a>
            </div>
        </div>
    </nav>
</header>

<main class="site-content">
    @Body
</main>

<footer class="site-footer">
    <div class="container footer-inner">
        <div>
            <span class="footer-brand">GAZETKA<span class="brand-dot">.</span></span>
            <p>Szkolne życie. Prawdziwe historie.</p>
        </div>

        <a href="/" class="footer-home">Powrót na górę ↑</a>
    </div>
</footer>