@page "/article/{Id:int}"

@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Interfaces.Service

@if (isLoading)
{
    <p>Ładowanie artykułu...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p role="alert">@errorMessage</p>
}
else if (article is null)
{
    <h2>Nie znaleziono artykułu</h2>
    <p>Artykuł o podanym identyfikatorze nie istnieje.</p>
}
else
{
    <article>
        <header>
            <h1>@article.Title</h1>
            <p>Autor: @article.Author</p>
        </header>

        <section>
            <p>@article.Text</p>
        </section>

        <footer>
            <a href="/">Wróć do strony głównej</a>
        </footer>
    </article>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Article? article;
    private bool isLoading = true;
    private string? errorMessage;

    [Inject]
    public IArticleService articleService { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = null;
        article = null;

        try
        {
            article = await articleService.GetArticleByIdAsync(Id);
        }
        catch (Exception)
        {
            errorMessage = "Nie udało się załadować artykułu. Spróbuj ponownie później.";
        }
        finally
        {
            isLoading = false;
        }
    }
}