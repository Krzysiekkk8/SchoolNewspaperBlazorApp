@page "/adminPanel"
@rendermode InteractiveServer

@using SchoolNewspaperBlazorApp.Components.Components
@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Interfaces.Service

@inject IArticleService articleService

<div class="main-block">

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p role="alert">@errorMessage</p>
    }

    @if (view == 0)
    {
        <h2>Panel administratora</h2>

        <button class="btn btn-primary" @onclick="LoadArticleAsync" disabled="@isLoading">
            @(isLoading ? "Ładowanie..." : "Panel artykułów")
        </button>

        <button class="btn btn-primary" @onclick="() => SetView(2)">
            Dodaj artykuł
        </button>

        <button class="btn btn-primary" @onclick="() => SetView(3)">
            + Dodaj użytkownika
        </button>
    }
    else if (view == 1)
    {
        <h2>Lista artykułów</h2>

        @if (articleList.Count == 0)
        {
            <p>Nie znaleziono artykułów.</p>
        }
        else
        {
            <div class="article-panel">
                <ArticleCard Articles="articleList" permissions="true" />
            </div>
        }
    }
    else if (view == 2)
    {
        <h2>Dodaj artykuł</h2>
        <ArticleForm />
    }
    else if (view == 3)
    {
        <h2>Dodawanie użytkownika</h2>
        <p>Formularz dodawania użytkownika nie został jeszcze podłączony.</p>
    }

    @if (view != 0)
    {
        <button class="btn btn-primary" @onclick="BackToMenu">
            Wróć
        </button>
    }

</div>

@code {
    private int view = 0;

    private List<Article> articleList = new();

    private bool isLoading = false;

    private string? errorMessage;

    private void SetView(int newView)
    {
        errorMessage = null;
        view = newView;
    }

    private async Task LoadArticleAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            articleList = await articleService.GetAllArticlesAsync();
            view = 1;
        }
        catch (Exception)
        {
            errorMessage = "Nie udało się pobrać listy artykułów.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void BackToMenu()
    {
        errorMessage = null;
        view = 0;
    }
}