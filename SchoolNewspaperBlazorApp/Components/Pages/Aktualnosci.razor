@page "/aktualnosci"
@using SchoolNewspaperBlazorApp.Components.Components
@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Interfaces.Service
@inject IArticleService articleService

<PageTitle>Aktualności | Gazetka</PageTitle>

<section class="news-page container py-5">
    <div class="mb-5">
        <p class="text-uppercase fw-bold"
           style="color: #a78bfa; letter-spacing: 4px;">
            ✦ ZE SZKOLNEGO ŻYCIA
        </p>

        <h1 class="display-3 fw-bold text-white">
            Co nowego<span style="color: #a78bfa;">?</span>
        </h1>

        <p style="color: #a5b4cf; max-width: 650px;">
            Najświeższe informacje, szkolne historie i wydarzenia,
            których nie warto przegapić.
        </p>
    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-light" role="status"></div>
            <p class="mt-3" style="color: #a5b4cf;">
                Ładujemy najnowsze wiadomości...
            </p>
        </div>
    }
    else if (articles.Count == 0)
    {
        <div class="article-panel p-5 text-center">
            <h3 class="text-white">Na razie cisza...</h3>
            <p style="color: #a5b4cf;">
                Wróć później — nowe artykuły już wkrótce!
            </p>
        </div>
    }
    else
    {
        <div class="article-panel p-3 p-md-4">
            <ArticleCard Articles="articles" permissions="false" />
        </div>
    }
</section>

@code {
    private List<Article> articles = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            articles = await articleService.GetAllArticlesAsync();
        }
        finally
        {
            loading = false;
        }
    }
}