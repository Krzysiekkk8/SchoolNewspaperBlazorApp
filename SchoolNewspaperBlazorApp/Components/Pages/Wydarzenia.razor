@page "/wydarzenia"

<PageTitle>Wydarzenia | Gazetka</PageTitle>

<section class="container py-5">
    <div class="mb-5">
        <p class="text-uppercase fw-bold"
           style="color: #38bdf8; letter-spacing: 4px;">
            ✦ ZAPISZ TĘ DATĘ
        </p>

        <h1 class="display-3 fw-bold text-white">
            Co przed nami<span style="color: #38bdf8;">?</span>
        </h1>

        <p style="color: #a5b4cf; max-width: 650px;">
            Najciekawsze momenty szkolnego życia zaczynają się tutaj.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <article class="article-card p-4 h-100">
                <span class="badge rounded-pill text-bg-primary mb-3">
                    SZKOŁA
                </span>

                <h3 class="text-white fw-bold">
                    Dzień talentów
                </h3>

                <p style="color: #a5b4cf;">
                    Muzyka, sztuka, występy i niezwykłe umiejętności
                    naszych uczniów.
                </p>

                <div class="mt-4" style="color: #a78bfa;">
                    ✦ Szczegóły wkrótce
                </div>
            </article>
        </div>

        <div class="col-md-6 col-lg-4">
            <article class="article-card p-4 h-100">
                <span class="badge rounded-pill text-bg-info mb-3">
                    SPORT
                </span>

                <h3 class="text-white fw-bold">
                    Szkolne rozgrywki
                </h3>

                <p style="color: #a5b4cf;">
                    Emocje, rywalizacja i wspólne kibicowanie.
                    Tutaj liczy się drużyna!
                </p>

                <div class="mt-4" style="color: #38bdf8;">
                    ✦ Szczegóły wkrótce
                </div>
            </article>
        </div>

        <div class="col-md-6 col-lg-4">
            <article class="article-card p-4 h-100">
                <span class="badge rounded-pill mb-3"
                      style="background: #701a75; color: white;">
                    KULTURA
                </span>

                <h3 class="text-white fw-bold">
                    Kreatywna szkoła
                </h3>

                <p style="color: #a5b4cf;">
                    Warsztaty, projekty i pomysły, które pozwalają
                    spojrzeć na szkołę z innej strony.
                </p>

                <div class="mt-4" style="color: #f0abfc;">
                    ✦ Szczegóły wkrótce
                </div>
            </article>
        </div>
    </div>
</section>