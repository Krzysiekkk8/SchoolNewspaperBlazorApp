@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Interfaces.Service
@using Microsoft.AspNetCore.Components.Forms

@inject IArticleService articleService
@inject IFileService fileService

<div class="add-article-form">
    <h2 class="add-article-title">Dodaj artykuł</h2>

    @if (previewImage != null)
    {
        <div class="preview-image">
            <img src="@previewImage" alt="Podgląd zdjęcia artykułu" />
        </div>
    }

    <div>
        <label for="articlePhoto">Zdjęcie artykułu</label>
        <InputFile id="articlePhoto"
                   OnChange="ChoosePhoto"
                   accept="image/*" />
    </div>

    <form @onsubmit="AddArticle" @onsubmit:preventDefault>
        <div>
            <label for="articleTitle">Tytuł</label>
            <input id="articleTitle"
                   @bind="Title"
                   class="form-control"
                   placeholder="Wpisz tytuł artykułu"
                   required
                   maxlength="200" />
        </div>

        <div>
            <label for="articleText">Treść artykułu</label>
            <textarea id="articleText"
                      @bind="Text"
                      class="form-control"
                      placeholder="Wpisz treść artykułu"
                      required
                      rows="8"></textarea>
        </div>

        <div>
            <label for="articleAuthor">Autor</label>
            <input id="articleAuthor"
                   @bind="Author"
                   class="form-control"
                   placeholder="Imię i nazwisko autora"
                   required
                   maxlength="150" />
        </div>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <p role="status">@message</p>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <p role="alert">@errorMessage</p>
        }

        <button type="submit" class="btn btn-primary" disabled="@isSaving">
            @(isSaving ? "Zapisywanie..." : "Dodaj artykuł")
        </button>
    </form>
</div>

@code {
    private string Title { get; set; } = "";
    private string Text { get; set; } = "";
    private string Author { get; set; } = "";

    private string? previewImage;
    private IBrowserFile? file;

    private bool isSaving;
    private string? message;
    private string? errorMessage;

    private async Task ChoosePhoto(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        message = null;

        file = e.File;

        try
        {
            previewImage = await fileService.GetPreviewAsync(file);
        }
        catch (Exception)
        {
            file = null;
            previewImage = null;
            errorMessage = "Nie udało się wczytać podglądu zdjęcia.";
        }
    }

    private async Task AddArticle()
    {
        if (isSaving)
            return;

        if (string.IsNullOrWhiteSpace(Title) ||
            string.IsNullOrWhiteSpace(Text) ||
            string.IsNullOrWhiteSpace(Author))
        {
            errorMessage = "Uzupełnij tytuł, treść i autora.";
            message = null;
            return;
        }

        isSaving = true;
        errorMessage = null;
        message = null;

        try
        {
            int imageId = 0;

            if (file != null)
            {
                imageId = await fileService.UploadImage(file);
            }

            await articleService.AddArticleAsync(
                Title.Trim(),
                Text.Trim(),
                Author.Trim(),
                imageId
            );

            Title = "";
            Text = "";
            Author = "";
            file = null;
            previewImage = null;

            message = "Artykuł został dodany.";
        }
        catch (Exception)
        {
            errorMessage = "Nie udało się dodać artykułu. Sprawdź dane i spróbuj ponownie.";
        }
        finally
        {
            isSaving = false;
        }
    }
}